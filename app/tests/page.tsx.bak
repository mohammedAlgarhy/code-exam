const getLevelColor = (level: string) => {
  switch(level) {
    case "Beginner": return "text-green-400 bg-green-900/30";
    case "Intermediate": return "text-yellow-400 bg-yellow-900/30";
    case "Advanced": return "text-orange-400 bg-orange-900/30";
    case "Expert": return "text-purple-400 bg-purple-900/30";
    default: return "text-gray-400 bg-gray-800/30";
  }
};

export default function TestsPage() {
  const headerRef = useRef(null);
  const statsRef = useRef(null);
  const sectionsRef = useRef<(HTMLDivElement | null)[]>([]);

  useEffect(() => {
    const ctx = gsap.context(() => {
      // هيدر: دوران 90 درجة إلى 0 (مدة 5 ثوانٍ)
      gsap.set(headerRef.current, { rotateX: 90, opacity: 0, transformOrigin: "center top" });
      gsap.to(headerRef.current, {
        rotateX: 0,
        opacity: 1,
        duration: 5,
        ease: "back.out(1.2)",
        delay: 0.2,
      });

      // البطاقات الإحصائية: مدة 5 ثوانٍ لكل بطاقة، تباعد 1 ثانية
      const statCards = statsRef.current?.children;
      if (statCards) {
        gsap.set(statCards, { rotateX: 90, opacity: 0, transformOrigin: "center top" });
        gsap.to(statCards, {
          rotateX: 0,
          opacity: 1,
          duration: 5,
          stagger: 1,
          ease: "back.out(1.2)",
          delay: 0.4,
        });
      }

      // أقسام التخصصات: مدة 5 ثوانٍ لكل قسم، تأخير متتالي بفارق 0.5 ثانية
      sectionsRef.current.forEach((section, idx) => {
        if (section) {
          gsap.set(section, { rotateX: 90, opacity: 0, transformOrigin: "center top" });
          gsap.to(section, {
            rotateX: 0,
            opacity: 1,
            duration: 5,
            delay: 1 + idx * 0.5,
            ease: "back.out(1.2)",
          });
        }
      });
    });
    return () => ctx.revert();
  }, []);

  return (
    <ProtectedRoute>
        <div className="min-h-screen bg-[#000000] text-white p-4">
        <div className="max-w-7xl mx-auto py-12">
          {/* الهيدر يظل في المنتصف */}
          <div className="text-center mb-12">
            <h1 className="text-5xl md:text-6xl font-bold mb-4 bg-gradient-to-r from-blue-400 via-cyan-500 to-teal-400 bg-clip-text text-transparent">
              Programming Tests
            </h1>
            <p className="text-xl text-gray-300">
              Choose your specialty and test your knowledge
            </p>
          </div>

          {/* إحصائيات */}
          <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
            <div className="bg-white/5 backdrop-blur-sm rounded-xl p-4 text-center border border-white/10">
              <div className="text-3xl font-bold text-cyan-400">27+</div>
              <div className="text-sm text-gray-400">Tests</div>
            </div>
            <div className="bg-white/5 backdrop-blur-sm rounded-xl p-4 text-center border border-white/10">
              <div className="text-3xl font-bold text-yellow-400">540+</div>
              <div className="text-sm text-gray-400">Questions</div>
            </div>
            <div className="bg-white/5 backdrop-blur-sm rounded-xl p-4 text-center border border-white/10">
              <div className="text-3xl font-bold text-green-400">1 min</div>
              <div className="text-sm text-gray-400">Per Question</div>
            </div>
            <div className="bg-white/5 backdrop-blur-sm rounded-xl p-4 text-center border border-white/10">
              <div className="text-3xl font-bold text-purple-400">70%</div>
              <div className="text-sm text-gray-400">To Pass</div>
            </div>
          </div>

          {/* التخصصات - الآن العنوان على اليمين */}
          {specialties.map((specialty) => (
            <div key={specialty.name} className="mb-16">
              {/* هنا نعكس الترتيب بحيث الأيقونة في اليسار والنص في اليمين */}
              <div className="flex flex-row-reverse justify-between items-center mb-6">
                <div className="flex items-center gap-3 text-right">
                  <div>
                    <h2 className="text-2xl font-bold">{specialty.name}</h2>
                    <p className="text-sm text-gray-400">اختر الاختبار المناسب</p>
                  </div>
                  <div className={`w-12 h-12 bg-gradient-to-r ${specialty.color} rounded-xl flex items-center justify-center text-2xl shadow-lg`}>
                    {specialty.icon}
                  </div>
                </div>
              </div>
              
              {/* شبكة الاختبارات */}
              <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                {specialty.tests.map((test) => (
                  <Link
                    key={test.path}
                    href={test.path}
                    className="group bg-white/5 backdrop-blur-sm rounded-xl p-5 border border-white/10 hover:border-cyan-500/50 transition-all hover:scale-105 hover:shadow-xl hover:bg-white/10"
                  >
                    <div className="flex items-center justify-between mb-3">
                      <div className="text-3xl">{test.icon}</div>
                      <span className="text-xs px-2 py-1 rounded-full bg-gray-800 text-gray-300">20 Qs</span>
                    </div>
                    <h3 className="text-lg font-bold mb-2 text-white group-hover:text-cyan-300 transition">{test.name}</h3>
                    <div className="flex justify-between items-center">
                      <span className={`text-xs px-2 py-0.5 rounded-full ${getLevelColor(test.level)}`}>
                        {test.level}
                      </span>
                      <span className="text-cyan-400 opacity-0 group-hover:opacity-100 transition-all group-hover:translate-x-1">
                        →
                      </span>
                    </div>
                  </Link>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </ProtectedRoute>
  );
}